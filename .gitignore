# ===== Unity (UnityScentSim/) =====
# Anchored to the Unity project folder so these never accidentally match a
# same-named folder inside Assets/ (e.g. a package ships its own nested
# "UserSettings" folder under Assets/CompositionLayers/ — that one is real
# content and must stay tracked).
#
# Regenerated caches/build output — never commit these, they can be
# gigabytes and cause nothing but merge pain.
/UnityScentSim/[Ll]ibrary/
/UnityScentSim/[Tt]emp/
/UnityScentSim/[Oo]bj/
/UnityScentSim/[Bb]uild/
/UnityScentSim/[Bb]uilds/
/UnityScentSim/[Ll]ogs/
/UnityScentSim/[Uu]ser[Ss]ettings/
/UnityScentSim/[Mm]emoryCaptures/
/UnityScentSim/[Rr]ecordings/
/UnityScentSim/ExportedObj/

# Autogenerated VS/Rider/MD solution and project files — regenerated by
# Unity on every open, machine-specific, worthless to commit.
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.idea/
*.sln.iml
.gradle/

# Unity crash/diagnostic output
sysinfo.txt
crashlytics-build.properties

# Build artifacts if anyone exports a player build into the repo folder
*.apk
*.aab
*.ipa
*.unitypackage
*.app

# Packed Addressables build cache (regenerated from AddressableAssetsData)
/UnityScentSim/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Packages lock file (usually fine to keep, uncomment to ignore instead)
# /UnityScentSim/Packages/packages-lock.json

# ===== Node (this repo's tooling) =====
node_modules/
npm-debug.log*

# ===== OS junk =====
.DS_Store
Thumbs.db
